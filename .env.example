DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MAX_TOKENS=4096
USE_LLM_PLANNER=true
USE_LLM_CONSTRAINTS=true
USE_LLM_GENERAL=true

PRODUCT_BACKEND=postgres
PRODUCT_CSV=data/mall_products_500_with_3d.csv
EMBEDDING_MODEL=intfloat/multilingual-e5-large
PRODUCT_TABLE=products
TOP_K_PRODUCTS=8
CHAINLIT_AUTH_SECRET=

# Optional: override only if running outside Docker Compose.
# PRODUCT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Optional: use Supabase cloud instead of the local Docker pgvector database.
# PRODUCT_BACKEND=supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
# SUPABASE_DB_DSN=
